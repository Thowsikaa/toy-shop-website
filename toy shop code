
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToyLand - Happy Toys for Happy Kids</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #fffaf3;
      color: #333;
    }

    header {
      background: #ff6b6b;
      color: white;
      padding: 18px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .logo {
      font-size: 28px;
      font-weight: bold;
    }

    nav {
      display: flex;
      gap: 20px;
      align-items: center;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: bold;
    }

    .cart {
      background: white;
      color: #ff6b6b;
      border: none;
      border-radius: 25px;
      padding: 10px 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .hero {
      text-align: center;
      padding: 65px 20px;
      background: #ffe66d;
    }

    .hero h1 {
      font-size: clamp(32px, 5vw, 48px);
      color: #e64b4b;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 18px;
      margin-bottom: 25px;
    }

    .shop-btn {
      display: inline-block;
      background: #6c63ff;
      color: white;
      padding: 13px 25px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: bold;
    }

    .section {
      padding: 45px 7%;
    }

    .section h2 {
      text-align: center;
      font-size: 30px;
      margin-bottom: 25px;
      color: #333;
    }

    .filters {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 28px;
    }

    .filters button {
      padding: 10px 18px;
      border: 2px solid #6c63ff;
      background: white;
      color: #6c63ff;
      border-radius: 22px;
      cursor: pointer;
    }

    .filters button.active,
    .filters button:hover {
      background: #6c63ff;
      color: white;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 24px;
    }

    .product {
      background: white;
      border-radius: 18px;
      padding: 20px;
      text-align: center;
      box-shadow: 0 4px 15px #00000010;
      transition: transform 0.2s;
    }

    .product:hover {
      transform: translateY(-5px);
    }

    .toy-image {
      height: 145px;
      display: grid;
      place-items: center;
      font-size: 85px;
      background: #f5f0ff;
      border-radius: 14px;
      margin-bottom: 16px;
    }

    .product h3 {
      margin-bottom: 10px;
    }

    .price {
      color: #ff6b6b;
      font-size: 21px;
      font-weight: bold;
      margin-bottom: 15px;
    }

    .add-btn {
      background: #6c63ff;
      color: white;
      border: none;
      border-radius: 25px;
      padding: 11px 20px;
      cursor: pointer;
      font-weight: bold;
    }

    .add-btn:hover {
      background: #5148df;
    }

    .about {
      background: #d9f7e8;
      text-align: center;
      padding: 45px 20px;
      line-height: 1.8;
    }

    footer {
      background: #333;
      color: white;
      text-align: center;
      padding: 25px;
      line-height: 1.8;
    }

    .cart-details {
      display: none;
      background: white;
      padding: 20px;
      margin: 20px 7%;
      border-radius: 12px;
      box-shadow: 0 4px 15px #00000010;
    }

    .cart-details h3 {
      margin-bottom: 12px;
    }

    .cart-line {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin: 12px 0;
    }

    .remove-btn {
      border: none;
      color: #e64b4b;
      background: transparent;
      cursor: pointer;
    }

    @media (max-width: 600px) {
      header {
        justify-content: center;
      }

      nav {
        justify-content: center;
        flex-wrap: wrap;
      }

      .section {
        padding: 35px 5%;
      }
    }
  </style>
</head>

<body>
  <header>
    <div class="logo">🧸 ToyLand</div>
    <nav>
      <a href="#home">Home</a>
      <a href="#products">Toys</a>
      <a href="#about">About</a>
      <button class="cart" onclick="toggleCart()">
        🛒 Cart (<span id="cart-count">0</span>)
      </button>
    </nav>
  </header>

  <section class="hero" id="home">
    <h1>Welcome to ToyLand! 🎉</h1>
    <p>Big smiles start with little toys. Find your next favorite!</p>
    <a class="shop-btn" href="#products">Explore Toys</a>
  </section>

  <section class="section" id="products">
    <h2>🌈 Our Popular Toys</h2>

    <div class="filters">
      <button class="active" onclick="filterToys('All', this)">All Toys</button>
      <button onclick="filterToys('Soft Toys', this)">Soft Toys</button>
      <button onclick="filterToys('Educational', this)">Educational</button>
      <button onclick="filterToys('Games', this)">Games</button>
    </div>

    <div class="products" id="product-list"></div>
  </section>

  <section class="cart-details" id="cart-details">
    <h3>🛍️ Your Shopping Cart</h3>
    <div id="cart-items"></div>
    <hr>
    <p style="margin: 15px 0; font-weight: bold;">
      Total: ₹<span id="cart-total">0</span>
    </p>
    <button class="add-btn" onclick="checkout()">Place Order</button>
  </section>

  <section class="about" id="about">
    <h2>💛 About ToyLand</h2>
    <p>
      We bring happiness to children with fun, creative and educational toys.
      Discover exciting toys for every little adventure!
    </p>
  </section>

  <footer>
    <h3>🧸 ToyLand</h3>
    <p>Making childhood more colorful!</p>
    <p>Email: hello@toyland.example</p>
    <p>© 2026 ToyLand. Demo website.</p>
  </footer>

  <script>
    const toys = [
      { id: 1, name: "Teddy Bear", price: 499, emoji: "🧸", category: "Soft Toys" },
      { id: 2, name: "Toy Car", price: 299, emoji: "🚗", category: "Games" },
      { id: 3, name: "Building Blocks", price: 599, emoji: "🧱", category: "Educational" },
      { id: 4, name: "Cute Bunny", price: 399, emoji: "🐰", category: "Soft Toys" },
      { id: 5, name: "Toy Robot", price: 799, emoji: "🤖", category: "Games" },
      { id: 6, name: "Colorful Puzzle", price: 249, emoji: "🧩", category: "Educational" },
      { id: 7, name: "Toy Dinosaur", price: 349, emoji: "🦖", category: "Games" },
      { id: 8, name: "Rainbow Unicorn", price: 549, emoji: "🦄", category: "Soft Toys" }
    ];

    let cart = [];

    function displayToys(category = "All") {
      const list = document.getElementById("product-list");

      const filtered = category === "All"
        ? toys
        : toys.filter(toy => toy.category === category);

      list.innerHTML = filtered.map(toy => `
        <div class="product">
          <div class="toy-image">${toy.emoji}</div>
          <h3>${toy.name}</h3>
          <p class="price">₹${toy.price}</p>
          <button class="add-btn" onclick="addToCart(${toy.id})">
            Add to Cart +
          </button>
        </div>
      `).join("");
    }

    function filterToys(category, button) {
      document.querySelectorAll(".filters button").forEach(btn => {
        btn.classList.remove("active");
      });

      button.classList.add("active");
      displayToys(category);
    }

    function addToCart(id) {
      const existing = cart.find(item => item.id === id);

      if (existing) {
        existing.quantity++;
      } else {
        cart.push({ id, quantity: 1 });
      }

      updateCart();
    }

    function updateCart() {
      const count = cart.reduce((sum, item) => sum + item.quantity, 0);
      const total = cart.reduce((sum, item) => {
        const toy = toys.find(toy => toy.id === item.id);
        return sum + toy.price * item.quantity;
      }, 0);

      document.getElementById("cart-count").textContent = count;
      document.getElementById("cart-total").textContent = total;

      const container = document.getElementById("cart-items");

      if (cart.length === 0) {
        container.innerHTML = "<p>Your cart is empty.</p>";
        return;
      }

      container.innerHTML = cart.map(item => {
        const toy = toys.find(toy => toy.id === item.id);

        return `
          <div class="cart-line">
            <span>${toy.emoji} ${toy.name} × ${item.quantity}</span>
            <span>
              ₹${toy.price * item.quantity}
              <button class="remove-btn"
                onclick="removeFromCart(${toy.id})">Remove</button>
            </span>
          </div>
        `;
      }).join("");
    }

    function removeFromCart(id) {
      cart = cart.filter(item => item.id !== id);
      updateCart();
    }

    function toggleCart() {
      const panel = document.getElementById("cart-details");
      panel.style.display =
        panel.style.display === "block" ? "none" : "block";

      updateCart();

      if (panel.style.display === "block") {
        panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    }

    function checkout() {
      if (cart.length === 0) {
        alert("Your cart is empty! Please add some toys.");
        return;
      }

      alert("Thank you for shopping at ToyLand! " +
        "This is a demo checkout. Online payment is not connected yet.");
    }

    displayToys();
    updateCart();
  </script>
</body>
</html>
